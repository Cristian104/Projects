# MyBrain Portal — service-specific env
# Shared keys (GEMINI_API_KEY, TELEGRAM_BOT_TOKEN_VANITAS, TELEGRAM_CHAT_ID)
# are loaded from ../../.env automatically.

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Telegram (MyBrain-specific bot, if different from root)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini (inherits from root .env, override here if needed)
GEMINI_API_KEY=
